@inject ICurrentUser Me
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DMS</title>
    <style>
        body { font-family: system-ui, Segoe UI, Arial, sans-serif; margin: 0; color: #222; }
        header { display: flex; gap: 1.25rem; align-items: center; padding: .75rem 1.5rem; background: #1f2937; color: #fff; }
        header a { color: #fff; text-decoration: none; }
        header a:hover { text-decoration: underline; }
        header .spacer { flex: 1; }
        header form { margin: 0; }
        main { padding: 1.5rem; max-width: 960px; margin: 0 auto; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid #d1d5db; padding: .45rem .7rem; text-align: left; }
        thead th { background: #1f2937; color: #fff; }
        tbody tr:nth-child(even) { background: #f3f4f6; }
        .alert { background: #fee2e2; border: 1px solid #fca5a5; color: #7f1d1d; padding: .6rem .9rem; margin-bottom: 1rem; }
        .error { color: #b91c1c; }
        .muted { color: #6b7280; }
        label { display: block; margin-top: .75rem; }
        input[type=text], input[type=password] { padding: .4rem; width: 18rem; max-width: 100%; }
        button { padding: .4rem .9rem; cursor: pointer; }
        a.button { display: inline-block; padding: .7rem 1.6rem; background: #005a43; color: #fff; text-decoration: none; border-radius: 4px; font-weight: 600; }
        a.button:hover { background: #014446; }
        header button { background: transparent; color: #fff; border: 1px solid #6b7280; }
    </style>
</head>
<body>
    <header>
        <a asp-controller="Home" asp-action="Index"><strong>DMS</strong></a>
        @if (Me.IsAuthenticated)
        {
            <a asp-controller="Dms" asp-action="Index">DMS</a>
            <a asp-controller="SharePoint" asp-action="Libraries">Libraries</a>
            <a asp-controller="SharePoint" asp-action="Lists">Lists</a>
            <span class="spacer"></span>
            <span>@Me.DisplayName</span>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit">Sign out</button>
            </form>
        }
    </header>
    <main>
        @if (TempData["Error"] is string error)
        {
            <div class="alert">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
